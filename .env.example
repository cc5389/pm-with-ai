# Optional: enables real, local responses. No paid API or key is required.
# First install Ollama and a model on your own machine.
# OLLAMA_MODEL=your-installed-model-name
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CONTEXT_WINDOW=8192
# ORCHESTRA_DB_PATH=./data/orchestra.sqlite

# Optional local LiteLLM gateway. Orchestra does not call it unless EVAL_EXECUTION=real.
# The gateway process needs its own provider key. Do not put that key in this file.
# LITELLM_URL=http://127.0.0.1:4000/v1/chat/completions
# LITELLM_MASTER_KEY=replace-with-the-private-gateway-password
