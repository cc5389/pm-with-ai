# Optional: enables real, local responses. No paid API or key is required.
# First install Ollama and a model on your own machine.
# OLLAMA_MODEL=your-installed-model-name
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CONTEXT_WINDOW=8192
# ORCHESTRA_DB_PATH=./data/orchestra.sqlite

# Optional local LiteLLM gateway. Orchestra does not call it unless EVAL_EXECUTION=real.
# The gateway process needs its own provider key. Do not put that key in this file.
# LITELLM_URL=http://127.0.0.1:4000/v1/chat/completions
# LITELLM_MASTER_KEY=replace-with-the-private-gateway-password

# Optional gateway mode (Request lab and Stage B/C). See docs/OLLAMA.md.
# ORCHESTRA_POOL=ollama
# Optional local quality judge through Ollama's OpenAI-compatible endpoint.
# JUDGE_BASE_URL=http://127.0.0.1:11434/v1
# JUDGE_MODEL=qwen3.5-judge

# The LiteLLM server and evaluation client MUST use the same private master key.
# Store it only in ignored .env.local / your secret store; never commit it.
# LITELLM_TIMEOUT_MS=600000
# Local Qwen judging disables thinking on every attempt.
# JUDGE_TIMEOUT_MS=600000
# Frozen measured Gemma calibration for the Stage C teammate run:
# ORCHESTRA_CALIBRATION_PATH=eval/results/calibration/ollama-quality.json
# STAGE_C_BUDGET_USD=0.10
# STAGE_C_VARIANT=all
# STAGE_C_RUN_ID=rtx5080-stage-c-001

# Optional: reproduce the Vercel browser-only public simulation demo locally.
# Vercel automatically enables this mode; it cannot be disabled with this flag.
# ORCHESTRA_PUBLIC_DEMO=1
